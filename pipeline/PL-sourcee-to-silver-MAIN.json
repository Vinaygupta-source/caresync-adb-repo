{
	"name": "PL-sourcee-to-silver-MAIN",
	"properties": {
		"activities": [
			{
				"name": "Read source metadata table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT table_id FROM ctrl.table_config where is_active=1 and source_system='@{pipeline().parameters.source_system}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlMetadataTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ingest all tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read source metadata table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read source metadata table').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Set variable1",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "test",
								"value": {
									"value": "@string(item().table_id)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Ingest source to silver",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Insert in progress status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL-source-to-silver-inner",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_id": {
										"value": "@item().table_id",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Insert in progress status",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT into ctrl.audit_log (adf_run_id,table_id,stage,status,start_time) values ('a1',@{item().table_id},'source_to_silver','In_progress',SYSUTCDATETIME())\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Update complete status",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Ingest source to silver",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT into ctrl.audit_log (adf_run_id,table_id,stage,status,start_time) values ('a1',@{item().table_id},'source_to_silver','In_progress',SYSUTCDATETIME())\n",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"source_system": {
				"type": "string",
				"defaultValue": "neon_postgres"
			}
		},
		"variables": {
			"test": {
				"type": "String"
			}
		},
		"annotations": []
	}
}